# ==============================================================================
# LNCT Connect — Frontend Environment Configuration Template
# ==============================================================================
# Copy this file to `.env.local` and substitute your actual Supabase credentials.
#
# IMPORTANT SECURITY RULES:
# 1. NEVER commit `.env` or `.env.local` containing real values to source control.
# 2. ONLY use your project's PUBLIC client keys (Publishable Key / Anon Key) here.
# 3. NEVER include the `service_role` secret key in any client-side environment file.
# ==============================================================================

# Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Client Key (Publishable Key or Anon Key)
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# Optional: Alternative/Legacy name for the public key (supported as fallback)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: Base Site URL for password recovery redirects (defaults to window.location.origin)
# Must match the configured Redirect URLs in Supabase Authentication settings.
VITE_SITE_URL=http://localhost:5173

# DEVELOPMENT ONLY: Explicit mock auth toggle
# Allows local offline dev sessions when live Supabase is not yet configured.
# Strictly disabled in production. Defaults to false.
VITE_ENABLE_MOCK_AUTH=false

